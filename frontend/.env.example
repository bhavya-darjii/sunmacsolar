NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Server-only (never NEXT_PUBLIC_): where the quote form, the Joey chat and the PPA form send
# enquiries (Surge's webhook), and the secret they're signed with. Surge holds the same secret as
# WEBSITE_ENQUIRY_SECRET. Set both in the Vercel project's environment variables.
SURGE_ENQUIRY_URL=https://surge-sunmac.vercel.app/api/webhooks/website
SURGE_ENQUIRY_SECRET=

# Server-only: where an email's unsubscribe link sends the token (/unsubscribe and
# /unsubscribe/one-click are this site's pages), and the secret that request is signed with. Not
# the enquiries' secret. SunMac's system holds the same value as WEBSITE_UNSUBSCRIBE_SECRET.
SURGE_UNSUBSCRIBE_URL=https://surge-sunmac.vercel.app/api/webhooks/unsubscribe
SURGE_UNSUBSCRIBE_SECRET=
